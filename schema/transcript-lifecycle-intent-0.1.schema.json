{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yukh.dev/coordination/schema/transcript-lifecycle-intent-0.1.schema.json",
  "title": "Yukh transcript lifecycle intent 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "operation_id", "transcript", "action", "reason", "policy_id", "policy_epoch", "policy_digest", "target", "high_water_receipt_reference", "requested_at", "requester_role_id", "authorizing_audit_receipt", "export_mode", "expected_backup_deletion_deadlines"],
  "properties": {
    "profile": {"const": "yukh-transcript-lifecycle-intent/v0.1"},
    "operation_id": {"$ref": "#/$defs/uuidv7"},
    "transcript": {"$ref": "#/$defs/transcript"},
    "action": {"enum": ["redact", "delete"]},
    "reason": {"enum": ["retention_expired", "authorized_request"]},
    "policy_id": {"$ref": "#/$defs/identifier"},
    "policy_epoch": {"$ref": "#/$defs/positiveSafeInteger"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "target": {"$ref": "#/$defs/target"},
    "high_water_receipt_reference": {"$ref": "#/$defs/reference"},
    "requested_at": {"$ref": "#/$defs/time"},
    "requester_role_id": {"$ref": "#/$defs/identifier"},
    "authorizing_audit_receipt": {"$ref": "#/$defs/reference"},
    "export_mode": {"enum": ["forbidden", "permitted", "required"]},
    "expected_backup_deletion_deadlines": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/eventDeadline"},
        {"$ref": "#/$defs/identityDeadline"},
        {"$ref": "#/$defs/auditDeadline"}
      ],
      "items": false
    }
  },
  "allOf": [
    {"if": {"properties": {"action": {"const": "redact"}}}, "then": {"properties": {"target": {"$ref": "#/$defs/sequenceTarget"}}}},
    {"if": {"properties": {"action": {"const": "delete"}}}, "then": {"properties": {"target": {"$ref": "#/$defs/transcriptTarget"}}}}
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,255}$"},
    "reference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"},
    "digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "uuidv7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "positiveSafeInteger": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "transcript": {"type": "object", "additionalProperties": false, "required": ["tenant_id", "channel_id", "transcript_epoch"], "properties": {"tenant_id": {"$ref": "#/$defs/identifier"}, "channel_id": {"$ref": "#/$defs/identifier"}, "transcript_epoch": {"$ref": "#/$defs/safeInteger"}}},
    "sequenceTarget": {"type": "object", "additionalProperties": false, "required": ["kind", "sequences"], "properties": {"kind": {"const": "sequences"}, "sequences": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/positiveSafeInteger"}}}},
    "transcriptTarget": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "transcript"}}},
    "target": {"oneOf": [{"$ref": "#/$defs/sequenceTarget"}, {"$ref": "#/$defs/transcriptTarget"}]},
    "deadline": {"type": "object", "additionalProperties": false, "required": ["domain", "deadline"], "properties": {"domain": {"enum": ["event", "identity", "security_audit"]}, "deadline": {"$ref": "#/$defs/time"}}},
    "eventDeadline": {"allOf": [{"$ref": "#/$defs/deadline"}, {"properties": {"domain": {"const": "event"}}}]},
    "identityDeadline": {"allOf": [{"$ref": "#/$defs/deadline"}, {"properties": {"domain": {"const": "identity"}}}]},
    "auditDeadline": {"allOf": [{"$ref": "#/$defs/deadline"}, {"properties": {"domain": {"const": "security_audit"}}}]},
    "safeInteger": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  }
}
