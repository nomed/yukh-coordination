{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://yukh.dev/coordination/schema/transcript-lifecycle-backup-recovery-0.1.schema.json",
  "title":"Yukh transcript lifecycle backup recovery 0.1",
  "type":"object","additionalProperties":false,
  "required":["profile","operation_id","intent_digest","status","reason","domains"],
  "properties":{
    "profile":{"const":"yukh-transcript-lifecycle-backup-recovery/v0.1"},
    "operation_id":{"$ref":"#/$defs/uuidv7"},"intent_digest":{"$ref":"#/$defs/digest"},
    "status":{"enum":["pending","incident","corrupt","completable"]},
    "reason":{"enum":["evidence_missing","receipt_failed","deadline_missed","contradictory_evidence","invalid_evidence","all_satisfied"]},
    "domains":{"type":"array","maxItems":3,"uniqueItems":true,"items":{"enum":["event","identity","security_audit"]}}
  },
  "allOf":[
    {"if":{"properties":{"status":{"const":"completable"}}},"then":{"properties":{"reason":{"const":"all_satisfied"},"domains":{"maxItems":0}}}},
    {"if":{"not":{"properties":{"status":{"const":"completable"}},"required":["status"]}},"then":{"properties":{"reason":{"not":{"const":"all_satisfied"}}}}}
  ],
  "$defs":{"digest":{"type":"string","pattern":"^sha-256:[0-9a-f]{64}$"},"uuidv7":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}
}
