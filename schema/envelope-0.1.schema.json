{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yukh.dev/coordination/schema/envelope-0.1.schema.json",
  "title": "Yukh Coordination event envelope 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "type",
    "channel",
    "source",
    "participant",
    "time",
    "data",
    "evidence",
    "extensions"
  ],
  "properties": {
    "specversion": { "const": "0.1" },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": {
      "enum": [
        "join",
        "presence",
        "leave",
        "claim",
        "progress",
        "question",
        "answer",
        "review_request",
        "verdict",
        "handoff_offer",
        "handoff_accept",
        "release"
      ]
    },
    "channel": { "type": "string", "format": "uri", "maxLength": 2048 },
    "source": { "type": "string", "format": "uri", "maxLength": 2048 },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "kind": { "enum": ["person", "session", "agent", "service"] },
        "display": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "format": "uri", "maxLength": 2048 }
      }
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "causation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "data": { "type": "object" },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "media_type"],
        "properties": {
          "uri": { "type": "string", "format": "uri", "maxLength": 2048 },
          "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["algorithm", "value"],
            "properties": {
              "algorithm": { "const": "sha-256" },
              "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "revision": { "type": "string", "minLength": 1, "maxLength": 256 },
          "description": { "type": "string", "maxLength": 512 }
        },
        "anyOf": [
          { "required": ["digest"] },
          { "required": ["revision"] }
        ]
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
      }
    }
  }
}
