{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yukh.dev/coordination/schema/receipt-0.1.schema.json",
  "title": "Signed relay receipt 0.1",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 24,
  "required": ["specversion", "receipt_version", "receipt_id", "event_id", "tenant_id", "channel_id", "channel_uri", "principal_id", "participant_id", "participant_instance_id", "session_epoch", "cursor", "transcript_epoch", "sequence", "accepted_at", "event_digest", "channel_metadata_digest", "acl_policy_version", "acl_policy_digest", "acl_decision_receipt_id", "append_outcome", "key_id", "signature_algorithm", "signature"],
  "properties": {
    "specversion": { "const": "0.1" },
    "receipt_version": { "const": "0.1" },
    "receipt_id": { "$ref": "envelope-0.1.schema.json#/$defs/uuidv7" },
    "event_id": { "$ref": "envelope-0.1.schema.json#/$defs/uuidv7" },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "channel_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "channel_uri": { "type": "string", "format": "uri", "maxLength": 2048 },
    "principal_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "participant_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "participant_instance_id": { "$ref": "envelope-0.1.schema.json#/$defs/uuidv7" },
    "session_epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "cursor": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "transcript_epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "accepted_at": { "$ref": "envelope-0.1.schema.json#/$defs/timestamp" },
    "event_digest": { "type": "string", "pattern": "^sha-256:[0-9a-f]{64}$" },
    "channel_metadata_digest": { "type": "string", "pattern": "^sha-256:[0-9a-f]{64}$" },
    "acl_policy_version": { "type": "string", "minLength": 1, "maxLength": 256 },
    "acl_policy_digest": { "type": "string", "pattern": "^sha-256:[0-9a-f]{64}$" },
    "acl_decision_receipt_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "append_outcome": { "const": "appended" },
    "key_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "signature_algorithm": { "const": "ed25519" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  }
}
